/* SP-404 MK2 Simple Converter - hardware sampler stylesheet */

QMainWindow, QWidget {
    background-color: #151617;
    color: #E5E5E5;
    font-family: "Segoe UI", sans-serif;
    font-size: 13px;
}

/* ---- Header ---- */
QLabel#titleLabel {
    font-size: 19px;
    font-weight: bold;
    color: #E5E5E5;
    letter-spacing: 1px;
}

/* ---- Group panels (FILES / OUTPUT / PROGRESS) ---- */
QGroupBox {
    background-color: #1C1D1F;
    border: 1px solid #45474A;
    border-radius: 6px;
    margin-top: 14px;
    padding-top: 2px;
    font-size: 11px;
    font-weight: bold;
    letter-spacing: 2px;
    color: #92959A;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
    background-color: transparent;
}

/* ---- Drop zone / queue list ---- */
QListWidget#dropList {
    background-color: #202124;
    border: 1px dashed #55585C;
    border-radius: 4px;
    padding: 4px;
    font-size: 12px;
    color: #E5E5E5;
    outline: none;
}

QListWidget#dropList[dragActive="true"] {
    border-color: #F5A623;
    background-color: #202124;
}

QListWidget#dropList::item {
    background-color: transparent;
    border: none;
    padding: 3px 6px;
    border-radius: 3px;
    color: #E5E5E5;
}

QListWidget#dropList::item:selected {
    background-color: #33363B;
    color: #F5A623;
}

QListWidget#dropList::item:hover {
    background-color: #2A2C30;
    color: #E5E5E5;
}

QListWidget#dropList:disabled {
    color: #383B40;
}

QScrollBar:vertical {
    background-color: #1C1D1F;
    width: 8px;
    border: none;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background-color: #45474A;
    border-radius: 4px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background-color: #F5A623;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background-color: #1C1D1F;
    height: 8px;
    border: none;
    margin: 2px;
}

QScrollBar::handle:horizontal {
    background-color: #45474A;
    border-radius: 4px;
    min-width: 24px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #F5A623;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* ---- Output selector row ---- */
QWidget#outputRow {
    background-color: #202124;
    border: 1px solid #45474A;
    border-radius: 4px;
}

QLabel#outputFieldText {
    color: #92959A;
    font-size: 12px;
}

QPushButton#browseBtn {
    background-color: transparent;
    border: none;
    padding: 8px 12px;
    color: #92959A;
    font-weight: bold;
    font-size: 12px;
}

QPushButton#browseBtn:hover {
    color: #F5A623;
    background-color: #2A2C30;
}

QPushButton#browseBtn:pressed {
    color: #161617;
    background-color: #F5A623;
}

QPushButton#browseBtn:disabled {
    color: #383B40;
}

/* ---- Progress bar ---- */
QProgressBar {
    background-color: #202124;
    border: 1px solid #45474A;
    border-radius: 4px;
    text-align: center;
    color: #E5E5E5;
    font-weight: bold;
    font-size: 12px;
}

QProgressBar::chunk {
    background-color: #F5A623;
    border-radius: 3px;
}

/* ---- Buttons ---- */
QPushButton {
    background-color: #202124;
    border: 1px solid #45474A;
    border-radius: 4px;
    padding: 6px 12px;
    color: #E5E5E5;
    font-weight: bold;
    font-size: 12px;
}

QPushButton:hover {
    border-color: #F5A623;
    color: #F5A623;
}

QPushButton:pressed {
    background-color: #F5A623;
    border-color: #F5A623;
    color: #161617;
}

QPushButton:disabled {
    background-color: #1C1D1F;
    border-color: #45474A;
    color: #383B40;
}

/* Primary action button (START) */
QPushButton#convertBtn {
    background-color: #F5A623;
    border: none;
    border-radius: 6px;
    padding: 12px 24px;
    color: #161617;
    font-size: 16px;
    font-weight: bold;
    letter-spacing: 2px;
}

QPushButton#convertBtn:hover {
    background-color: #FFB52E;
    color: #161617;
}

QPushButton#convertBtn:pressed {
    background-color: #d8901d;
    color: #161617;
}

QPushButton#convertBtn:disabled {
    background-color: #2A2C30;
    border: 1px solid #45474A;
    color: #383B40;
}

/* ---- Labels ---- */
QLabel#statusLabel {
    font-size: 12px;
    color: #92959A;
}

QLabel#footerLabel {
    font-size: 11px;
    color: #6E7175;
    letter-spacing: 1px;
}

/* ---- Checkbox (compact) ---- */
QCheckBox {
    color: #E5E5E5;
    font-size: 12px;
    spacing: 6px;
}

QCheckBox:hover {
    color: #F5A623;
}

QCheckBox::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid #45474A;
    border-radius: 3px;
    background-color: #202124;
}

QCheckBox::indicator:hover {
    border-color: #F5A623;
}

QCheckBox::indicator:checked {
    background-color: #F5A623;
    border-color: #F5A623;
}

QCheckBox:disabled {
    color: #383B40;
}

QCheckBox:disabled::indicator {
    border-color: #383B40;
}

/* ---- Sample-rate selector ---- */
QComboBox {
    background-color: #202124;
    border: 1px solid #45474A;
    border-radius: 4px;
    padding: 6px 10px;
    color: #E5E5E5;
    font-size: 12px;
    font-weight: bold;
}

QComboBox:hover {
    border-color: #F5A623;
    color: #F5A623;
}

QComboBox:disabled {
    background-color: #1C1D1F;
    border-color: #45474A;
    color: #383B40;
}

QComboBox QAbstractItemView {
    background-color: #202124;
    border: 1px solid #45474A;
    selection-background-color: #33363B;
    selection-color: #F5A623;
    color: #E5E5E5;
    outline: none;
}